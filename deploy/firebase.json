{
  "hosting": {
    "site": "mycx-hosting",
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      {
        "source": "/tokount{,/**}",
        "run": { "serviceId": "tokount", "region": "us-central1" }
      },
      {
        "source": "/api/tokount",
        "run": { "serviceId": "tokount", "region": "us-central1" }
      },
      {
        "source": "**",
        "run": { "serviceId": "mycx-hosting", "region": "us-central1" }
      }
    ]
  }
}
